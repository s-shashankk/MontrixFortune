# Frontend Razorpay public key (safe to expose in frontend)
VITE_RAZORPAY_KEY_ID=rzp_test_your_key_id

# Backend Razorpay credentials (server-side only)
RAZORPAY_KEY=rzp_test_your_key_id
RAZORPAY_SECRET=your_razorpay_secret

# Optional webhook secret
RAZORPAY_WEBHOOK_SECRET=whsec_your_webhook_secret

# Database
DB_URL=jdbc:mysql://localhost:3306/montrix_furniture
DB_USERNAME=montrix_app
DB_PASSWORD=change-me

# JWT (each at least 32 characters; generate with: openssl rand -base64 48)
JWT_SECRET=change-me-to-a-long-random-string-1
JWT_REFRESH_SECRET=change-me-to-a-long-random-string-2

# Comma-separated list of frontend origins allowed by CORS
APP_CORS_ORIGINS=http://localhost:5173

# First admin account, created at start-up if the e-mail does not exist (password at least 10 characters)
ADMIN_EMAIL=owner@yourdomain.com
ADMIN_PASSWORD=change-me-to-a-long-password
ADMIN_NAME=Store Admin

# Product catalog / demo data
APP_SEED_CATALOG=true
APP_SEED_DEMO_USERS=false
APP_SEED_REPLACE_CATALOG=false
